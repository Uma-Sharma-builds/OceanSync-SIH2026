<?xml version="1.0"?>

<sdf version="1.6">
  <model name="oceansync_auv">

    <static>false</static>

    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
   <link name="buoyancy_volume">

  <pose>0 0 0 0 0 0</pose>

  <inertial>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.001</ixx>
      <iyy>0.001</iyy>
      <izz>0.001</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name="buoyancy_collision">
    <geometry>
      <box>
        <size>2.0 0.8 0.6</size>
      </box>
    </geometry>
  </collision>

  <visual name="buoyancy_visual">
    <visible>false</visible>
    <geometry>
      <box>
        <size>2.0 0.8 0.6</size>
      </box>
    </geometry>
  </visual>

</link>

<joint name="buoyancy_volume_joint" type="fixed">
  <parent>base_link</parent>
  <child>buoyancy_volume</child>
</joint>
      <inertial>
        <mass>50.0</mass>

        <inertia>
          <ixx>8.0</ixx>
          <iyy>18.0</iyy>
          <izz>20.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Temporary body.
           Later this can be replaced by the final CAD mesh. -->
      <collision name="body_collision">
        <geometry>
          <box>
            <size>2.0 0.8 0.6</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>2.0 0.8 0.6</size>
          </box>
        </geometry>
      </visual>

      <!-- ========================= -->
      <!-- IMU                       -->
      <!-- ========================= -->

      <sensor name="imu" type="imu">

        <always_on>true</always_on>
        <update_rate>100</update_rate>

        <plugin
          name="imu_plugin"
          filename="libgazebo_ros_imu_sensor.so">

          <ros>
            <namespace>/oceansync</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>

          <frame_name>imu_link</frame_name>

        </plugin>

      </sensor>


      <!-- ========================= -->
      <!-- CAMERA                    -->
      <!-- ========================= -->

      <sensor name="camera" type="camera">

        <pose>1.0 0 0 0 0 0</pose>

        <always_on>true</always_on>
        <update_rate>20</update_rate>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>

        </camera>

        <plugin
          name="camera_plugin"
          filename="libgazebo_ros_camera.so">

          <ros>
            <namespace>/oceansync</namespace>
            <remapping>image_raw:=camera/image_raw</remapping>
          </ros>

          <camera_name>underwater_camera</camera_name>
          <frame_name>camera_link</frame_name>

        </plugin>

      </sensor>


      <!-- ========================= -->
      <!-- SONAR / RAY SENSOR        -->
      <!-- ========================= -->

      <sensor name="sonar" type="ray">

        <pose>1.0 0 0 0 0 0</pose>

        <always_on>true</always_on>
        <update_rate>10</update_rate>

        <ray>

          <scan>

            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>

          </scan>

          <range>
            <min>0.2</min>
            <max>50.0</max>
            <resolution>0.05</resolution>
          </range>

        </ray>

        <plugin
          name="sonar_plugin"
          filename="libgazebo_ros_ray_sensor.so">

          <ros>
            <namespace>/oceansync</namespace>
            <remapping>~/out:=sonar/scan</remapping>
          </ros>

          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>sonar_link</frame_name>

        </plugin>

      </sensor>

    </link>


    <!-- ========================= -->
    <!-- SENSOR FRAMES             -->
    <!-- ========================= -->

    <link name="imu_link"/>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>


    <link name="camera_link"/>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>


    <link name="sonar_link"/>

    <joint name="sonar_joint" type="fixed">
      <parent>base_link</parent>
      <child>sonar_link</child>
    </joint>


    <!-- ========================= -->
    <!-- BUOYANCY                  -->
    <!-- ========================= -->



  </model>
</sdf>
