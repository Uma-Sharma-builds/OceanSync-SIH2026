<?xml version="1.0"?>
<sdf version="1.7">

  <model name="oceansync_sensor_rig">

    <!-- Temporary underwater test vehicle -->
    <pose>0 0 -2 0 0 0</pose>
    <static>true</static>

    <link name="base_link">

      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>2.0 1.0 0.5</size>
          </box>
        </geometry>

        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <!-- IMU -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- Forward underwater camera -->
      <sensor name="underwater_camera" type="camera">
        <pose>0.9 0 -0.05 0 0 0</pose>

        <always_on>true</always_on>
        <update_rate>15</update_rate>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>

      <!-- Forward LiDAR -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.8 0 -0.2 0 0 0</pose>

        <always_on>true</always_on>
        <update_rate>10</update_rate>

        <lidar>

          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.2</min>
            <max>50.0</max>
            <resolution>0.01</resolution>
          </range>

        </lidar>
      </sensor>

    </link>

  </model>

</sdf>
