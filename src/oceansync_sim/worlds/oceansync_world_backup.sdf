<?xml version="1.0"?>
<sdf version="1.6">
  <world name="oceansync_world">

    <gravity>0 0 -9.81</gravity>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Underwater environment: water surface at z = 0 -->
    <scene>
      <ambient>0.15 0.2 0.25 1</ambient>
      <background>0.02 0.08 0.12 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.7 0.8 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Seabed -->
    <model name="seabed">
      <static>true</static>

      <link name="seabed_link">

        <collision name="collision">
          <pose>0 0 -10 0 0 0</pose>
          <geometry>
            <box>
              <size>100 100 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 -10 0 0 0</pose>
          <geometry>
            <box>
              <size>100 100 0.2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- OceanSync AUV -->
    <include>
      <uri>model://oceansync_auv</uri>
      <name>oceansync_auv</name>
      <pose>0 0 -5 0 0 0</pose>
    </include>

  </world>
</sdf>
