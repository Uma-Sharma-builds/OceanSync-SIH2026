<?xml version="1.0"?>
<sdf version="1.6">

  <world name="oceansync_world">

    <gravity>0 0 -9.81</gravity>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- ============================== -->
    <!-- UNDERWATER ATMOSPHERE          -->
    <!-- ============================== -->

    <scene>

      <ambient>0.02 0.08 0.12 1</ambient>

      <background>0.01 0.04 0.07 1</background>

      <shadows>true</shadows>

      <fog>
        <color>0.01 0.12 0.18</color>
        <type>linear</type>
        <start>10</start>
        <end>80</end>
      </fog>

    </scene>


    <!-- ============================== -->
    <!-- SUN                            -->
    <!-- ============================== -->

    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 50 0 0 0</pose>

      <diffuse>0.7 0.8 0.9 1</diffuse>

      <specular>0.2 0.3 0.4 1</specular>

      <direction>
        -0.3 0.2 -1
      </direction>

    </light>


    <!-- ============================== -->
    <!-- SEA FLOOR                      -->
    <!-- ============================== -->

    <model name="seabed">

      <static>true</static>

      <link name="seabed_link">

        <collision name="seabed_collision">

          <pose>0 0 -20 0 0 0</pose>

          <geometry>

            <box>
              <size>200 200 1</size>
            </box>

          </geometry>

        </collision>


        <visual name="seabed_visual">

          <pose>0 0 -20 0 0 0</pose>

          <geometry>

            <box>
              <size>200 200 1</size>
            </box>

          </geometry>

          <material>

            <ambient>0.15 0.10 0.05 1</ambient>

            <diffuse>0.25 0.18 0.08 1</diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ============================== -->
    <!-- WATER VOLUME                   -->
    <!-- ============================== -->

    <model name="ocean_volume">

      <static>true</static>

      <link name="water_volume">

        <visual name="water_visual">

          <pose>0 0 -10 0 0 0</pose>

          <geometry>

            <box>
              <size>200 200 20</size>
            </box>

          </geometry>

          <material>

            <ambient>0.0 0.12 0.20 0.65</ambient>

            <diffuse>0.0 0.25 0.40 0.65</diffuse>

            <specular>0.3 0.5 0.6 1</specular>

            <transparency>0.35</transparency>

          </material>

        </visual>

      </link>

    </model>


    <!-- ============================== -->
    <!-- WATER SURFACE                  -->
    <!-- ============================== -->

    <model name="water_surface">

      <static>true</static>

      <link name="surface_link">

        <visual name="surface_visual">

          <pose>0 0 0 0 0 0</pose>

          <geometry>

            <plane>

              <normal>0 0 1</normal>

              <size>200 200</size>

            </plane>

          </geometry>

          <material>

            <ambient>0.0 0.18 0.28 1</ambient>

            <diffuse>0.0 0.35 0.50 1</diffuse>

            <specular>0.7 0.8 0.9 1</specular>

            <shininess>100</shininess>

          </material>

        </visual>

      </link>

    </model>


    <!-- ============================== -->
    <!-- AUV                            -->
    <!-- ============================== -->

    <include>

      <uri>model://oceansync_auv</uri>

      <name>oceansync_auv</name>

      <pose>0 0 -5 0 0 0</pose>

    </include>


  </world>

</sdf>
